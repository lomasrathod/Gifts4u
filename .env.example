# Copy to .env.local for local development. Every value is optional locally:
# without them the app uses a local database, local photo folder, a fake
# checkout, printed emails and a template writer.

# Public URL of the site (emails, payment return links). On Vercel this
# falls back to the project's production domain.
APP_URL=http://localhost:3000

# Database: any Postgres URL. On Vercel, add Supabase or Neon from the
# Marketplace and POSTGRES_URL is set for you. Tables are created on first use.
DATABASE_URL=

# Photos: Vercel Blob (private store). Set automatically when you connect a
# Blob store to the Vercel project. Empty = photos saved in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Multiplayer for the 3D worlds: Supabase Realtime (no server to run).
# Empty locally = the dev server in realtime/node-server.ts (npm run dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payments: Dodo Payments. In production, checkout stays closed until both
# payments and a database are configured.
DODO_API_KEY=
DODO_ENV=test            # test | live
DODO_PRODUCT_ID=         # one "pay what you want" one-time product; amount is set per order
DODO_WEBHOOK_SECRET=     # whsec_..., webhook URL: https://YOUR-DOMAIN/api/webhooks/dodo

# Email: Resend. Empty = emails printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Giftvera <hello@giftvera.com>"

# AI writer (Claude). Empty = built-in template writer.
ANTHROPIC_API_KEY=

# Protects /api/cron/run. Vercel Cron sends it automatically when set.
CRON_SECRET=
