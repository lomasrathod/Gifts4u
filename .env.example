# Public URL of the site (used in emails and payment return links)
APP_URL=http://localhost:3000

# Database (libSQL / Turso). Local file by default.
DATABASE_URL=file:.data/giftvera.db
DATABASE_AUTH_TOKEN=

# Payments: Dodo Payments. Leave empty to use the built-in dev checkout.
DODO_API_KEY=
DODO_ENV=test            # test | live
DODO_PRODUCT_ID=         # one "pay what you want" one-time product; amount is set per order
DODO_WEBHOOK_SECRET=     # whsec_...

# Email: Resend. Leave empty to print emails to the server log.
RESEND_API_KEY=
EMAIL_FROM="Giftvera <hello@giftvera.com>"

# AI writer (Claude). Leave empty to use the built-in template writer.
ANTHROPIC_API_KEY=

# Photo storage: Cloudflare R2 (S3 API). Leave empty to store photos in .data/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Realtime server for 3D worlds (node server locally, Cloudflare worker in production)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8787

# Protects /api/cron/* (scheduled emails, expiry reminders)
CRON_SECRET=change-me
